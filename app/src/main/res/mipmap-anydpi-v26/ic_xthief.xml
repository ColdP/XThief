<?xml version="1.0" encoding="utf-8"?>
<!--
  Layered (adaptive) launcher icon.

  The single-layer PNG at res/drawable-nodpi/ic_xthief.png is kept untouched: the Super Island
  notification still passes it, since a focus notification wants one flat bitmap. Only the launcher
  entry point uses this adaptive version.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_xthief_background" />
    <foreground android:drawable="@drawable/ic_xthief_foreground_inset" />
    <monochrome android:drawable="@drawable/ic_xthief_foreground_inset" />
</adaptive-icon>
